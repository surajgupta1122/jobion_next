## Local development (dummy)
#
# This project expects MySQL + JWT.
# Copy this file to `.env` (which is gitignored) and adjust if needed.
#
#   copy .env.example .env
#

# MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=password
DB_NAME=jobion

# Auth
